# Docker: comment this out. Compose then uses /var/run/docker.sock.
# Podman rootless: keep this line. If Docker keeps it, Traefik cannot see other containers.
CONTAINER_SOCKET=${XDG_RUNTIME_DIR}/podman/podman.sock

# Reminder for Host(`app.lan.home`). Changing this does not update labels by itself;
# edit samples/26-traefik/docker-compose.yml too.
TRAEFIK_DOMAIN=lan.home
