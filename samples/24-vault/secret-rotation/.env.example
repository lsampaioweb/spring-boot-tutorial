# Copy this file to .env and fill in the actual values
# .env is in .gitignore and should never be committed

# Development defaults to http://localhost:8200. Production must set VAULT_URI to an HTTPS endpoint.
# VAULT_URI=

# Local tutorial/bootstrap token only. Production must use a scoped token or workload identity.
VAULT_TOKEN=

# KV v2 mount name (default: secret)
VAULT_KV_BACKEND=secret
